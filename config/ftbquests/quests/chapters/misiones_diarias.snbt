  icon: "minecraft:clock"
  id: "1800000000000000"
  order_index: 7
  progression_mode: "flexible"
  title: "Misiones diarias"
  quests: [
    { description: ["Objetivo de combate de la rotación diaria. Cuenta cualquier criatura considerada hostil por el juego." "" "§6Objetivo: §fMata 12 criaturas hostiles." "§7El progreso es personal y comienza cuando esta misión aparece activa hoy."] icon: "minecraft:iron_sword" id: "1800000000001001" invisible: true invisible_until_tasks: 1 title: "Mata 12 criaturas hostiles" x: 0 y: 0 tasks: [{ id: "1800000000011001" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021001" title: "Mata 12 criaturas hostiles" type: "custom" }] rewards: [] }
    { description: ["Objetivo de combate de la rotación diaria. Cuenta zombis, esqueletos y las demás criaturas registradas como no muertas." "" "§6Objetivo: §fMata 6 criaturas no muertas." "§7El progreso es personal y solo cuenta durante el ciclo activo."] icon: "minecraft:rotten_flesh" id: "1800000000001002" invisible: true invisible_until_tasks: 1 title: "Mata 6 no muertos" x: 3 y: 0 tasks: [{ id: "1800000000011002" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021002" title: "Mata 6 no muertos" type: "custom" }] rewards: [] }
    { description: ["Objetivo de combate de la rotación diaria. Cuenta arañas y otras criaturas clasificadas como artrópodos." "" "§6Objetivo: §fMata 4 arañas o artrópodos." "§7El contador comienza al activarse la misión de hoy."] icon: "minecraft:spider_eye" id: "1800000000001003" invisible: true invisible_until_tasks: 1 title: "Mata 4 arañas o artrópodos" x: 6 y: 0 tasks: [{ id: "1800000000011003" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021003" title: "Mata 4 arañas o artrópodos" type: "custom" }] rewards: [] }
    { description: ["Objetivo de combate de la rotación diaria. Los creepers deben morir por una acción atribuida a tu jugador." "" "§6Objetivo: §fMata 3 creepers." "§7El progreso anterior a la activación no se recupera."] icon: "minecraft:gunpowder" id: "1800000000001004" invisible: true invisible_until_tasks: 1 title: "Mata 3 creepers" x: 9 y: 0 tasks: [{ id: "1800000000011004" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021004" title: "Mata 3 creepers" type: "custom" }] rewards: [] }
    { description: ["Derrota enemigos utilizando daño a distancia. Sirven arcos, ballestas y otros proyectiles que el servidor pueda atribuirte." "" "§6Objetivo: §fMata 5 enemigos con proyectiles." "§7El progreso es individual y pertenece al ciclo actual."] icon: "minecraft:bow" id: "1800000000001005" invisible: true invisible_until_tasks: 1 title: "Mata 5 enemigos con proyectiles" x: 12 y: 0 tasks: [{ id: "1800000000011005" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021005" title: "Mata 5 enemigos con proyectiles" type: "custom" }] rewards: [] }
    { description: ["Cualquier daño que inflijas a criaturas enemigas contribuye al total mientras esta misión esté activa." "" "§6Objetivo: §fInflige 250 puntos de daño a enemigos." "§7No es necesario hacerlo contra una sola criatura."] icon: "minecraft:diamond_sword" id: "1800000000001006" invisible: true invisible_until_tasks: 1 title: "Inflige 250 puntos de daño a enemigos" x: 0 y: 0 tasks: [{ id: "1800000000011006" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021006" title: "Inflige 250 puntos de daño a enemigos" type: "custom" }] rewards: [] }
    { description: ["Excava piedra normal o pizarra profunda durante el ciclo actual. Las variantes compatibles cuentan según las etiquetas del servidor." "" "§6Objetivo: §fRompe 64 bloques de piedra o pizarra profunda." "§7Los bloques rotos antes de activarse la misión no cuentan."] icon: "minecraft:deepslate" id: "1800000000001007" invisible: true invisible_until_tasks: 1 title: "Rompe 64 bloques de piedra o pizarra profunda" x: 3 y: 0 tasks: [{ id: "1800000000011007" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021007" title: "Rompe 64 bloques de piedra o pizarra profunda" type: "custom" }] rewards: [] }
    { description: ["Extrae bloques reconocidos como minerales. Se aceptan minerales vanilla y de mods cuando pertenecen a las etiquetas compatibles." "" "§6Objetivo: §fExtrae 12 bloques de mineral." "§7El progreso es personal y comienza con la activación diaria."] icon: "minecraft:iron_ore" id: "1800000000001008" invisible: true invisible_until_tasks: 1 title: "Extrae 12 bloques de cualquier mineral" x: 6 y: 0 tasks: [{ id: "1800000000011008" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021008" title: "Extrae 12 bloques de cualquier mineral" type: "custom" }] rewards: [] }
    { description: ["Extrae carbón directamente de sus bloques de mineral. El carbón obtenido de cofres o intercambios no incrementa este contador." "" "§6Objetivo: §fExtrae 8 minerales de carbón." "§7Solo cuenta la extracción realizada durante el ciclo activo."] icon: "minecraft:coal_ore" id: "1800000000001009" invisible: true invisible_until_tasks: 1 title: "Extrae 8 minerales de carbón" x: 9 y: 0 tasks: [{ id: "1800000000011009" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021009" title: "Extrae 8 minerales de carbón" type: "custom" }] rewards: [] }
    { description: ["Extrae mineral de hierro o cobre. Las variantes de pizarra profunda cuentan igual que las normales." "" "§6Objetivo: §fExtrae 6 minerales de hierro o cobre." "§7El contador no mide los lingotes ni los minerales en bruto guardados."] icon: "minecraft:raw_iron" id: "1800000000001010" invisible: true invisible_until_tasks: 1 title: "Extrae 6 minerales de hierro o cobre" x: 12 y: 0 tasks: [{ id: "1800000000011010" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021010" title: "Extrae 6 minerales de hierro o cobre" type: "custom" }] rewards: [] }
    { description: ["Corta troncos de cualquier especie reconocida por las etiquetas del juego. Los troncos ya guardados no cuentan." "" "§6Objetivo: §fCorta 24 troncos." "§7La misión registra los bloques rotos durante el ciclo actual."] icon: "minecraft:oak_log" id: "1800000000001011" invisible: true invisible_until_tasks: 1 title: "Corta 24 troncos" x: 0 y: 0 tasks: [{ id: "1800000000011011" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021011" title: "Corta 24 troncos" type: "custom" }] rewards: [] }
    { description: ["Reúne materiales básicos de construcción rompiendo arena, grava o arcilla. Puedes combinar los tres tipos hasta alcanzar el total." "" "§6Objetivo: §fRecoge 24 bloques de arena, grava o arcilla." "§7El progreso comienza al aparecer la misión de hoy."] icon: "minecraft:sand" id: "1800000000001012" invisible: true invisible_until_tasks: 1 title: "Recoge 24 bloques de arena, grava o arcilla" x: 3 y: 0 tasks: [{ id: "1800000000011012" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021012" title: "Recoge 24 bloques de arena, grava o arcilla" type: "custom" }] rewards: [] }
    { description: ["Cosecha cultivos completamente maduros. Las plantas recogidas antes de alcanzar su última fase pueden no contar." "" "§6Objetivo: §fRecoge 24 cultivos maduros." "§7El contador es individual y se reinicia con el siguiente ciclo."] icon: "minecraft:wheat" id: "1800000000001013" invisible: true invisible_until_tasks: 1 title: "Recoge 24 cultivos maduros" x: 6 y: 0 tasks: [{ id: "1800000000011013" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021013" title: "Recoge 24 cultivos maduros" type: "custom" }] rewards: [] }
    { description: ["Planta semillas o cultivos reconocidos por el contador diario. Puedes utilizar una sola especie o combinar varias." "" "§6Objetivo: §fPlanta 24 cultivos." "§7Solo cuentan las plantaciones realizadas tras la activación."] icon: "minecraft:wheat_seeds" id: "1800000000001014" invisible: true invisible_until_tasks: 1 title: "Planta 24 cultivos" x: 9 y: 0 tasks: [{ id: "1800000000011014" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021014" title: "Planta 24 cultivos" type: "custom" }] rewards: [] }
    { description: ["Alimenta animales compatibles para completar dos procesos de cría. Cada pareja que produzca una cría suma una vez." "" "§6Objetivo: §fCría dos parejas de animales." "§7El progreso pertenece al jugador que realiza la alimentación."] icon: "minecraft:wheat" id: "1800000000001015" invisible: true invisible_until_tasks: 1 title: "Cría dos parejas de animales" x: 12 y: 0 tasks: [{ id: "1800000000011015" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021015" title: "Cría dos parejas de animales" type: "custom" }] rewards: [] }
    { description: ["Utiliza tijeras sobre ovejas que todavía tengan lana. Cada oveja esquilada suma una vez." "" "§6Objetivo: §fEsquila 4 ovejas." "§7Recoger lana de cofres o del suelo no aumenta el contador."] icon: "minecraft:shears" id: "1800000000001016" invisible: true invisible_until_tasks: 1 title: "Esquila cuatro ovejas" x: 0 y: 0 tasks: [{ id: "1800000000011016" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021016" title: "Esquila cuatro ovejas" type: "custom" }] rewards: [] }
    { description: ["Pesca utilizando una caña. Cuentan peces, tesoros y basura obtenidos mediante una captura válida." "" "§6Objetivo: §fPesca 3 objetos." "§7El progreso empieza cuando esta misión queda seleccionada para hoy."] icon: "minecraft:fishing_rod" id: "1800000000001017" invisible: true invisible_until_tasks: 1 title: "Pesca tres objetos" x: 3 y: 0 tasks: [{ id: "1800000000011017" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021017" title: "Pesca tres objetos" type: "custom" }] rewards: [] }
    { description: ["Procesa objetos en hornos u otros bloques compatibles con el contador diario. Puedes combinar comida cocinada y materiales fundidos." "" "§6Objetivo: §fCocina o funde 16 objetos." "§7Solo cuenta el resultado recogido durante el ciclo activo."] icon: "minecraft:furnace" id: "1800000000001018" invisible: true invisible_until_tasks: 1 title: "Cocina o funde 16 objetos" x: 6 y: 0 tasks: [{ id: "1800000000011018" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021018" title: "Cocina o funde 16 objetos" type: "custom" }] rewards: [] }
    { description: ["Consume alimentos hasta completar cinco usos válidos. Las bebidas o consumibles especiales solo cuentan si el juego los registra como comida." "" "§6Objetivo: §fConsume 5 alimentos." "§7El contador es personal y se reinicia con el ciclo diario."] icon: "minecraft:cooked_beef" id: "1800000000001019" invisible: true invisible_until_tasks: 1 title: "Consume cinco alimentos" x: 9 y: 0 tasks: [{ id: "1800000000011019" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021019" title: "Consume cinco alimentos" type: "custom" }] rewards: [] }
    { description: ["Completa intercambios válidos con aldeanos. Puedes comerciar varias veces con el mismo aldeano o utilizar comerciantes distintos." "" "§6Objetivo: §fRealiza 3 intercambios con aldeanos." "§7El progreso se atribuye al jugador que confirma cada intercambio."] icon: "minecraft:emerald" id: "1800000000001020" invisible: true invisible_until_tasks: 1 title: "Realiza tres intercambios con aldeanos" x: 12 y: 0 tasks: [{ id: "1800000000011020" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021020" title: "Realiza tres intercambios con aldeanos" type: "custom" }] rewards: [] }
    { description: ["Coloca bloques durante una construcción o reparación. La misión acepta cualquier bloque que el contador pueda registrar." "" "§6Objetivo: §fColoca 48 bloques." "§7Retirar y volver a colocar bloques puede contar, pero el objetivo está pensado para construir de verdad."] icon: "minecraft:bricks" id: "1800000000001021" invisible: true invisible_until_tasks: 1 title: "Coloca 48 bloques" x: 0 y: 0 tasks: [{ id: "1800000000011021" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021021" title: "Coloca 48 bloques" type: "custom" }] rewards: [] }
    { description: ["Fabrica o coloca antorchas para iluminar una base, una mina o una ruta de exploración. Ambos métodos contribuyen al mismo objetivo." "" "§6Objetivo: §fFabrica o coloca 24 antorchas." "§7El progreso anterior a la activación no se añade retroactivamente."] icon: "minecraft:torch" id: "1800000000001022" invisible: true invisible_until_tasks: 1 title: "Fabrica o coloca 24 antorchas" x: 3 y: 0 tasks: [{ id: "1800000000011022" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021022" title: "Fabrica o coloca 24 antorchas" type: "custom" }] rewards: [] }
    { description: ["Desplázate caminando o corriendo sin utilizar monturas, vehículos ni teletransporte. El contador acumula la distancia recorrida por tu jugador." "" "§6Objetivo: §fRecorre 1.000 bloques a pie." "§7La distancia se mide durante el ciclo diario activo."] icon: "minecraft:leather_boots" id: "1800000000001023" invisible: true invisible_until_tasks: 1 title: "Recorre 1.000 bloques a pie" x: 6 y: 0 tasks: [{ id: "1800000000011023" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021023" title: "Recorre 1.000 bloques a pie" type: "custom" }] rewards: [] }
    { description: ["Recorre distancia nadando en agua. Permanecer flotando en el mismo lugar no incrementa el objetivo." "" "§6Objetivo: §fNada 200 bloques." "§7El contador es personal y empieza al activarse la misión."] icon: "minecraft:kelp" id: "1800000000001024" invisible: true invisible_until_tasks: 1 title: "Nada 200 bloques" x: 9 y: 0 tasks: [{ id: "1800000000011024" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021024" title: "Nada 200 bloques" type: "custom" }] rewards: [] }
    { description: ["Realiza saltos válidos mientras la misión esté activa. Los impulsos provocados por mecanismos pueden no registrarse como un salto del jugador." "" "§6Objetivo: §fSalta 50 veces." "§7El progreso se reinicia al comenzar un nuevo ciclo diario."] icon: "minecraft:rabbit_foot" id: "1800000000001025" invisible: true invisible_until_tasks: 1 title: "Salta 50 veces" x: 12 y: 0 tasks: [{ id: "1800000000011025" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021025" title: "Salta 50 veces" type: "custom" }] rewards: [] }
    { description: ["Obtén experiencia mediante combate, minería, hornos, misiones u otros métodos válidos. Se cuenta la experiencia ganada, no el nivel total almacenado." "" "§6Objetivo: §fObtén 150 puntos de experiencia." "§7Retirar experiencia de sistemas externos solo cuenta si genera una ganancia reconocida."] icon: "minecraft:experience_bottle" id: "1800000000001026" invisible: true invisible_until_tasks: 1 title: "Obtén 150 puntos de experiencia" x: 0 y: 0 tasks: [{ id: "1800000000011026" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021026" title: "Obtén 150 puntos de experiencia" type: "custom" }] rewards: [] }
    { description: ["Fabrica objetos mediante recetas reconocidas por el contador. Las cantidades producidas en una misma operación contribuyen según el resultado registrado." "" "§6Objetivo: §fFabrica 20 objetos." "§7Los objetos fabricados antes de activarse la misión no cuentan."] icon: "minecraft:crafting_table" id: "1800000000001027" invisible: true invisible_until_tasks: 1 title: "Fabrica 20 objetos" x: 3 y: 0 tasks: [{ id: "1800000000011027" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021027" title: "Fabrica 20 objetos" type: "custom" }] rewards: [] }
    { description: ["Utiliza una cama y completa correctamente el descanso. Entrar en la cama sin pasar la noche puede no ser suficiente." "" "§6Objetivo: §fDuerme una vez." "§7La misión debe estar activa cuando finalice el descanso."] icon: "minecraft:red_bed" id: "1800000000001028" invisible: true invisible_until_tasks: 1 title: "Duerme una vez" x: 6 y: 0 tasks: [{ id: "1800000000011028" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021028" title: "Duerme una vez" type: "custom" }] rewards: [] }
    { description: ["Rompe bloques de cualquier tipo durante el ciclo actual. Sirven tareas de minería, tala, excavación o demolición." "" "§6Objetivo: §fRompe 100 bloques." "§7El contador registra acciones, no bloques que ya estuvieran en el inventario."] icon: "minecraft:iron_pickaxe" id: "1800000000001029" invisible: true invisible_until_tasks: 1 title: "Rompe 100 bloques de cualquier tipo" x: 9 y: 0 tasks: [{ id: "1800000000011029" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021029" title: "Rompe 100 bloques de cualquier tipo" type: "custom" }] rewards: [] }
    { description: ["Permanece jugando de forma activa durante el tiempo indicado. El sistema evita premiar largos periodos sin actividad." "" "§6Objetivo: §fJuega activamente durante 15 minutos." "§7El tiempo se acumula únicamente dentro del ciclo actual."] icon: "minecraft:clock" id: "1800000000001030" invisible: true invisible_until_tasks: 1 title: "Juega activamente durante 15 minutos" x: 12 y: 0 tasks: [{ id: "1800000000011030" optional: true title: "Activa hoy" type: "custom" } { id: "1800000000021030" title: "Juega activamente durante 15 minutos" type: "custom" }] rewards: [] }
    { description: ["Cada ciclo selecciona cinco objetivos del catálogo diario. Completa al menos tres para desbloquear esta recompensa adicional." "" "§6Recompensa: §fUna Case de nivel C+1 respecto a tu rango al reclamar, con C16 como máximo." "§7El progreso y la reclamación son individuales aunque formes parte de un equipo FTB."] icon: "minecraft:chest" id: "1800000000000020" shape: "hexagon" title: "Tres de cinco" x: 6 y: 3 tasks: [{ id: "1800000000000110" title: "Completa 3 de 5" type: "custom" }] rewards: [{ exclude_from_claim_all: true icon: "casesmod:case_item" id: "1800000000000201" title: "Case C+1 por completar 3/5" type: "custom" }] }
    { description: ["Puedes reclamar una Case gratuita una vez por jugador y ciclo diario." "" "§6Reinicio: §f04:00, zona horaria Europe/Madrid." "§6Recompensa: §fUna Case C+1 según tu rango al reclamar, con C16 como máximo." "§7La recompensa debe reclamarse manualmente y no se incluye en Reclamar todo."] icon: "casesmod:case_item" id: "1800000000000030" shape: "hexagon" title: "Case gratuita diaria" x: 0 y: 3 tasks: [{ id: "1800000000000120" title: "Case gratuita diaria" type: "custom" }] rewards: [{ exclude_from_claim_all: true icon: "casesmod:case_item" id: "1800000000000202" title: "Case C+1 gratuita" type: "custom" }] }
  ]
}
